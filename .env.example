# Copiar este archivo como ".env" y completar los valores.

# --- Origen de los datos ---
# wifi   = el ESP32 envía las lecturas por WiFi (usar API_KEY y secrets.h)
# serial = lectura por cable USB (usar PUERTO_SERIAL y BAUDIOS)
ENTRADA=wifi
PUERTO_WEB=5000
# Clave compartida con codigo_esp32/secrets.h. Generar con:
#   python -c "import secrets; print(secrets.token_hex(16))"
API_KEY=

# --- Puerto serial (solo si ENTRADA=serial) ---
# Puerto del ESP32 (o del Arduino) en Windows, ej: COM5. Ver en Administrador de dispositivos.
PUERTO_SERIAL=COM5
# 115200 si se lee el ESP32, 9600 si se lee el Arduino directamente
BAUDIOS=115200
# 1 = genera datos falsos para probar sin hardware
SIMULAR=0

# --- Calibración LM393 (valor analógico 0-1023) ---
# Sensor al aire (seco): valor alto. Sensor sumergido en agua: valor bajo.
# Medir ambos con el monitor serie y ajustar.
ADC_SECO=1000
ADC_MOJADO=400

# --- Límites de humedad (%) ---
HUMEDAD_MIN=70
HUMEDAD_MAX=80

# --- Temperatura del sustrato, DS18B20 (ideal 18-25 °C; estos son los valores por defecto) ---
# TEMP_SUS_MIN=18
# TEMP_SUS_MAX=25
# Críticos (por defecto 10 y 30): TEMP_SUS_CRIT_MIN / TEMP_SUS_CRIT_MAX

# --- Límites del ambiente, DHT11 (opcionales) ---
# Sin valores no hay alertas ni colores de aviso. Deben definirse el mínimo y el máximo.
# TEMP_AMB_MIN=15
# TEMP_AMB_MAX=25
# HUM_AMB_MIN=40
# HUM_AMB_MAX=80

# --- Telegram ---
# Token: crear el bot con @BotFather. Chat ID: escribir al bot y abrir
# https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=
# Minutos mínimos entre alertas repetidas del mismo sensor
ALERTA_ESPERA_MIN=30
